{
  "name": "dsh-stitch-mcp",
  "version": "0.4.1",
  "description": "Google Stitch as native mcp__stitch__* tools in DeepSeek Harness, with an in-panel credential card for the API Key and OAuth access token.",
  "type": "module",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "google-stitch",
    "mcp",
    "ui-design"
  ],
  "license": "MIT",
  "author": "yangjiacheng",
  "homepage": "https://github.com/oooplz/dsh-stitch-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oooplz/dsh-stitch-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/oooplz/dsh-stitch-mcp/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  }
}
